<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>local.day-recap</string>
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/.local/bin/claude</string>
    <string>-p</string>
    <string>/day-recap</string>
    <string>--model</string>
    <string>sonnet</string>
    <string>--allowedTools</string>
    <string>Bash(python3 __HOME__/.claude/skills/day-recap/collect.py*) Edit(/__HOME__/recaps/**) mcp__claude_ai_Google_Calendar__list_events mcp__claude_ai_Atlassian__searchJiraIssuesUsingJql mcp__claude_ai_Slack__slack_send_message</string>
  </array>
  <key>WorkingDirectory</key><string>__HOME__/recaps</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>__HOME__/.local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
  </dict>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>16</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>16</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>16</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>16</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>16</integer><key>Minute</key><integer>0</integer></dict>
  </array>
  <key>StandardOutPath</key><string>__HOME__/recaps/.log</string>
  <key>StandardErrorPath</key><string>__HOME__/recaps/.log</string>
</dict>
</plist>
